```

## Exploratory Analysis

```{r}

IGNITE_Summary <- IGNITE_Data_Sheet_2 |> 
  group_by(Species, Site ) |> 
  summarize(Mean_FMC = mean(FMC, na.rm = TRUE),
            sd_FMC = sd(FMC, na.rm = TRUE))

ggplot(IGNITE_Summary) +
  aes(x = Species, y = Mean_FMC, fill = Species)+
  geom_col(position = "dodge")+
  geom_errorbar(aes(ymin = Mean_FMC - sd_FMC, 
                ymax = Mean_FMC + sd_FMC, width = 0.5))+
                  facet_wrap(Site~.)+
                  theme_bw()+
                  theme(axis.text.x = element_text(angle = 68, hjust = 1, size = 7, color = "black"))

IGNITE_Summary_Sampling_Dates <- IGNITE_Data_Sheet_2 |> 
  group_by(Species, Date ) |> 
  summarize(Mean_FMC = mean(FMC, na.rm = TRUE),
            sd_FMC = sd(FMC, na.rm = TRUE))

IGNITE_Summary_Sampling_Dates

ggplot(IGNITE_Summary_Sampling_Dates) +
  aes(x = Species, y = Mean_FMC, fill = Species)+
  geom_col(position = "dodge")+
  geom_errorbar(aes(ymin = Mean_FMC - sd_FMC, 
                    ymax = Mean_FMC + sd_FMC, width = 0.5))+
  facet_wrap(Date~.)+
  theme_bw()+
  theme(axis.text.x = element_text(angle = 68, hjust = 1, size = 7, color = "black"))


```

