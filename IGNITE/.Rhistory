library(tidyverse)
library(readxl)
library(dplyr)
IGNITE_Data_Sheet <- read_excel("IGNITE Data Sheet.xlsx",
sheet = "RCoding")
View(IGNITE_Data_Sheet)
ggplot(IGNITE_Data_Sheet) +
aes(x = FMC) +
geom_bar()
ggplot(IGNITE_Data_Sheet) +
aes(x = FMC, group = Species) +
geom_bar()
ggplot(IGNITE_Data_Sheet) +
aes(x = FMC, group = Species, color = Species) +
geom_bar()
ggplot(IGNITE_Data_Sheet) +
aes(x = FMC, color = Species) +
geom_bar()
IGNITE_Data_Sheet_2 <- IGNITE_Data_Sheet |>
filter( FMC < 500)
ggplot(IGNITE_Data_Sheet_2) +
aes(x = FMC, color = Species) +
geom_bar()
library(tidyverse)
library(readxl)
library(dplyr)
library(lme4)
library(lmerTest)
IGNITE_Data_Sheet <- read_excel("IGNITE Data Sheet.xlsx",
sheet = "RCoding")
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC color = Species) +
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC color = Species) +
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, color = Species) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, group = Species) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, group = Site) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, group = Site, color = site) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, group = Site, color = Site) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, color = Site) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, fill = Site) +
geom_col()
ggplot(IGNITE_Data_Sheet_2) +
aes(x = Species, y = FMC, fill = Site) +
geom_col()+
scale_fill_brewer(palette = "Set1")
ggplot(IGNITE_Data_Sheet_2) +
