ymax = Mean_FMC + sd_FMC, width = 0.5))+
facet_wrap(Date~.)+
theme_bw()+
theme(axis.text.x = element_text(angle = 68, hjust = 1, size = 7, color = "black"))
ggplot(IGNITE_Summary) +
aes(x = Species, y = Mean_FMC, fill = Species)+
geom_col(position = "dodge")+
theme_bw()+
theme(axis.text.x = element_text(size = 7, color = "black"))
#combined results so far
ggplot(IGNITE_Data_Sheet_2)+
aes(x = FMC)+
geom_histogram()
#Data does not look that normal, will proceed
#FMC_model <- lmer(FMC ~ Species + Phenology + Percent_Green + (1 | Site/Bottle_ID) + (1| Date), data = IGNITE_Data_Sheet_2)
#Boundary error, let me see what I can drop
summary(FMC_model)
ggplot(IGNITE_Data_Sheet_2)+
aes(x = FMC)+
geom_histogram()
#Data does not look that normal, will proceed
#FMC_model <- lmer(FMC ~ Species + Phenology + Percent_Green + (1 | Site/Bottle_ID) + (1| Date), data = IGNITE_Data_Sheet_2)
#Boundary error, let me see what I can drop
#summary(FMC_model)
#VarCorr(FMC_model)
#Site and Bottle ID was causing the issue, will drop it for now...
FMC_model <- lmer(FMC ~ Species + Phenology + Percent_Green  + (1| Date), data = IGNITE_Data_Sheet_2)
#Perfect, it no longer pops up
hist(residuals(FMC_model))
plot(FMC_model, which = "2")
ggqqplot(residuals(FMC_model))
summary(FMC_model)
anova(FMC_model, type = "2")
View(IGNITE_Data_Sheet_2)
