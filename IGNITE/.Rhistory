filter(!(Species == "California sagebrush" & Phenology == "Dormant")) |>
group_by(Species) |>
summarize(Mean_FMC = mean(FMC, na.rm = TRUE),
sd_FMC = sd(FMC, na.rm = TRUE))
#This is with dead and dormant sagebrush removed
ggplot(IGNITE_Summary_Species) +
aes(x = Species, y = Mean_FMC, fill = Species)+
geom_col(position = "dodge")+
geom_errorbar(aes(ymin = Mean_FMC - sd_FMC,
ymax = Mean_FMC + sd_FMC, width = 0.5))+
#facet_wrap(Species~.)+
theme_bw()+
theme(axis.text.x = element_text(angle = 68, hjust = 1, size = 7, color = "black"))
IGNITE_Summary_Phenology <- IGNITE_Data_Sheet_2 |>
group_by(Species, Phenology ) |>
summarize(Mean_FMC = mean(FMC, na.rm = TRUE),
sd_FMC = sd(FMC, na.rm = TRUE))
ggplot(IGNITE_Summary_Phenology) +
aes(x = Phenology, y = Mean_FMC, fill = Species)+
geom_col(position = "dodge")+
geom_errorbar(aes(ymin = Mean_FMC - sd_FMC,
ymax = Mean_FMC + sd_FMC, width = 0.5))+
facet_wrap(Species~.)+
theme_bw()+
theme(axis.text.x = element_text(angle = 68, hjust = 1, size = 7, color = "black"))
#Makes sense since flowering is a new phenology type
#Also it makes sense with the variation between dead and dormant for the Sd
View(IGNITE_Summary_Phenology)
